{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incident-rag-study.internal/contracts/retrieval_schema_v1.json",
  "title": "RetrievalSchemaV1",
  "description": "Strict schema for retrieved context chunks passed from retrieval to generation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "flow_id",
    "alert_id",
    "retrieval_timestamp",
    "query_text",
    "chunks"
  ],
  "properties": {
    "flow_id": {
      "type": "string",
      "minLength": 1,
      "description": "Network flow identifier matching input alert"
    },
    "alert_id": {
      "type": "string",
      "pattern": "^ALT-[0-9]{8}-[0-9]{4}$",
      "description": "Alert identifier"
    },
    "retrieval_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of retrieval execution"
    },
    "query_text": {
      "type": "string",
      "minLength": 1,
      "description": "Dense search query synthesized from alert and SHAP attributions"
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "description": "Retrieved evidence chunks (default k=5)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_id",
          "source",
          "content",
          "similarity_score"
        ],
        "properties": {
          "chunk_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": ["chroma_mitre_kb", "chroma_iot_docs", "tavily_web_cache"],
            "description": "Originating knowledge source"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "description": "Raw text excerpt of knowledge chunk"
          },
          "similarity_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Vector cosine similarity or relevance score"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Optional metadata such as technique ID, URL, or document title"
          }
        }
      }
    }
  }
}
