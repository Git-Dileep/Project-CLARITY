{
  "dataset_name": "ACI-IoT-Network-2023",
  "is_synthetic": false,
  "input_path": "input_data/aci_2023/*.csv",
  "target_column": "Label",
  "flow_id_column": "Flow ID",
  "timestamp_column": "Timestamp",
  "device_id_column": null,
  "metadata_columns": [
    "Source IP",
    "Destination IP",
    "Flow ID",
    "Timestamp",
    "source_file",
    "sample_id"
  ],
  "drop_columns": [
    "Source IP",
    "Destination IP",
    "Flow ID",
    "Timestamp"
  ],
  "numeric_columns": null,
  "categorical_columns": null,
  "max_rows_per_class": 50000,
  "test_size": 0.2,
  "random_seed": 42,
  "chunksize": 250000,
  "traditional": {
    "rf_n_estimators": 200,
    "rf_max_depth": 20,
    "xgb_n_estimators": 200,
    "xgb_max_depth": 6,
    "xgb_learning_rate": 0.08,
    "mlp_hidden_layer_sizes": [
      128,
      64
    ],
    "mlp_max_iter": 100,
    "mlp_early_stopping": true
  },
  "dl": {
    "enabled": true,
    "batch_size": 128,
    "epochs": 15,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "cnn_channels": 64,
    "lstm_hidden": 64,
    "transformer_dim": 64,
    "transformer_heads": 4,
    "early_stopping_patience": 3,
    "device": "auto"
  },
  "explainability": {
    "top_n_features": 10,
    "background_samples": 100,
    "traditional_explainer": "TreeExplainer",
    "dl_explainer": "GradientExplainer"
  },
  "pilot": {
    "pilot_size": 20,
    "min_classes": 5,
    "stratified": true
  },
  "reports_dir": "reports",
  "models_dir": "models",
  "data_dir": "input_data/aci_2023"
}
